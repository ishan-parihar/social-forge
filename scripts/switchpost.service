[Unit]
Description=Switchpost API Server
Documentation=https://github.com/ishan-parihar/switchpost
# No external services: storage is a local SQLite file, migrated on startup.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# User/Group/Environment are written dynamically by install.sh — do not edit here
User=%%USER%%
Group=%%GROUP%%
Environment=SWITCHPOST_DIR=%%INSTALL_DIR%%
ExecStart=/usr/local/bin/switchpost-start.sh
WorkingDirectory=%%INSTALL_DIR%%
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120
# Allow enough file descriptors for many concurrent connections
LimitNOFILE=65536
# Prevent core dumps leaking secrets
LimitCORE=0

[Install]
WantedBy=multi-user.target
