  "query": "SELECT t.id as \"id!: Uuid\", t.name, t.color,\n                  t.created_at as \"created_at!: DateTime<Utc>\",\n                  t.updated_at as \"updated_at!: DateTime<Utc>\"\n           FROM post_tags pt\n           JOIN tags t ON pt.tag_id = t.id\n           WHERE pt.post_id = ? AND t.user_id = ?\n           ORDER BY t.name",
