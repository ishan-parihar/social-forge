  "query": "SELECT t.id, t.name, t.color, t.created_at, t.updated_at\n           FROM post_tags pt\n           JOIN tags t ON pt.tag_id = t.id\n           WHERE pt.post_id = $1 AND t.user_id = $2\n           ORDER BY t.name",
