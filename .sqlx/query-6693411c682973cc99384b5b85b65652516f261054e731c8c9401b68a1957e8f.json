  "query": "UPDATE signatures SET\n           name = COALESCE($3, name),\n           content = COALESCE($4, content),\n           provider = COALESCE($5, provider),\n           updated_at = now()\n           WHERE id = $1 AND user_id = $2\n           RETURNING id, user_id, name, content, provider,\n             created_at, updated_at",
