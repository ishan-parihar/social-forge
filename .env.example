# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://postiz:postiz@localhost:5432/postiz

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-a9f3b2c1d4e5
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# ── Logging ──────────────────────────────────────────────────
RUST_LOG=info,postiz_rust=debug

# ── Social Providers (OAuth2 credentials) ───────────────────

# X / Twitter (OAuth 2.0 PKCE)
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn (OAuth 2.0)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Bluesky (AT Protocol — uses username + app password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Facebook (OAuth 2.0 + Graph API)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Instagram (OAuth 2.0 + Graph API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── Media Storage ───────────────────────────────────────────
# Local filesystem (MVP). Set to S3-compatible for production.
MEDIA_STORAGE=local
MEDIA_DIR=./uploads
