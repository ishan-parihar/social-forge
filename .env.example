# ─── Postiz-Rust Configuration ─────────────────────────────────
# Copy to .env and fill in your values.
# The app will use defaults where sensible defaults exist.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgres://postiz:postiz@localhost:5432/postiz

# ── Application URLs ─────────────────────────────────────────
# Public-facing URL of the API (used for OAuth callbacks)
APP_URL=http://localhost:3000
# Frontend URL for CORS + redirects
FRONTEND_URL=http://localhost:5173

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-hex-string

# ── Token Encryption (optional but recommended for production) ──
# 64 hex chars = 32 bytes = AES-256-GCM key
# TOKEN_ENCRYPTION_KEY=

# ── Media Storage ───────────────────────────────────────────
MEDIA_DIR=./uploads

# ── Social Provider Credentials ─────────────────────────────
# Only configure the ones you want to use.

## X / Twitter (OAuth 2.0 PKCE)
# Create an app at https://developer.twitter.com
X_CLIENT_ID=
X_CLIENT_SECRET=

## LinkedIn (OAuth 2.0 PKCE)
# Create an app at https://www.linkedin.com/developers/apps
# LinkedIn Page uses the same credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

## Bluesky (App Password — no OAuth)
# Use your handle and an App Password (Settings → App Passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

## Facebook (OAuth 2.0 PKCE)
# Create an app at https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

## Instagram (via Facebook Graph API)
# Uses the same Facebook app credentials + Instagram Business account
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

## Instagram Standalone (Basic Display API)
# Uses separate app credentials from Instagram (not Facebook)
# Create an app at https://developers.facebook.com → Instagram Basic Display
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

## Threads (Meta Threads API v1.0)
# Create an app at https://developers.facebook.com → Threads
THREADS_APP_ID=
THREADS_APP_SECRET=

## YouTube (Google OAuth 2.0)
# Create credentials at https://console.cloud.google.com → YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

## Reddit (OAuth 2.0)
# Create an app at https://www.reddit.com/prefs/apps (type: "web app")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

## Discord (OAuth 2.0 + Bot)
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

## Telegram (Bot API)
# Create a bot at https://t.me/BotFather and get the token
TELEGRAM_TOKEN=

## Pinterest (API v5 OAuth)
# Create an app at https://developers.pinterest.com
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# ── Logging ─────────────────────────────────────────────────
# Set to debug, info, warn, or error
# RUST_LOG=info,postiz_rust=debug
