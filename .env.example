# ─── Social Forge Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.

# ── Core (Required) ─────────────────────────────────────────
DATABASE_URL=postgres://social_forge:social_forge@localhost:5432/social_forge

# ── Server ──────────────────────────────────────────────────
# APP_URL is the public-facing URL of your instance.
# Used for OAuth redirect URIs: {APP_URL}/api/auth/callback
# Default: http://localhost:3000
# For self-hosting behind a tunnel/proxy, set to your public URL:
#   APP_URL=https://social-forge.yourdomain.com
APP_URL=http://localhost:3000

# FRONTEND_URL controls CORS allowed origins.
# Default: same as APP_URL (recommended for single-origin deployment)
# FRONTEND_URL=http://localhost:3000

# JWT secret for auth tokens (auto-generated in dev if not set)
# JWT_SECRET=your-secret-key-here

# ── Security (Recommended) ──────────────────────────────────
# 64 hex chars (32 bytes) — encrypts OAuth tokens at rest
# TOKEN_ENCRYPTION_KEY=

# ── X / Twitter ─────────────────────────────────────────────
# Option 1: Cookie auth (recommended — enables full GraphQL API)
# X_AUTH_TOKEN=
# X_CT0=
# Option 2: OAuth 2.0 (limited to Twitter API v2)
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# ── Reddit ──────────────────────────────────────────────────
# Option 1: Cookie auth (recommended — enables voting, moderation)
# Cookies are auto-extracted from browser, or submit via web form.
# Option 2: OAuth (script app)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# Option 3: Pre-obtained tokens
# REDDIT_ACCESS_TOKEN=
# REDDIT_REFRESH_TOKEN=

# ── LinkedIn ────────────────────────────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# ── Facebook / Instagram ────────────────────────────────────
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# ── Threads ─────────────────────────────────────────────────
# THREADS_APP_ID=
# THREADS_APP_SECRET=

# ── YouTube / Google ────────────────────────────────────────
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# ── TikTok ──────────────────────────────────────────────────
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# ── Pinterest ───────────────────────────────────────────────
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=

# ── Discord ─────────────────────────────────────────────────
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=

# ── Slack ───────────────────────────────────────────────────
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# ── Telegram ────────────────────────────────────────────────
# Bot API (comma-separated tokens for multi-bot)
# TELEGRAM_BOT_TOKENS=
# User client (Grammers — for personal account automation)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION_DIR=./data/telegram

# ── WhatsApp ────────────────────────────────────────────────
# WHATSAPP_STORE_DIR=./data/whatsapp

# ── Bluesky ─────────────────────────────────────────────────
# BLUESKY_HANDLE=
# BLUESKY_APP_PASSWORD=

# ── Mastodon ────────────────────────────────────────────────
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
# MASTODON_INSTANCE_URL=

# ── Medium ──────────────────────────────────────────────────
# MEDIUM_ACCESS_TOKEN=

# ── Dev.to ──────────────────────────────────────────────────
# DEVTO_API_KEY=

# ── Hashnode ────────────────────────────────────────────────
# HASHNODE_API_KEY=

# ── GitHub ──────────────────────────────────────────────────
# GITHUB_TOKEN=

# ── Media Storage ───────────────────────────────────────────
# MEDIA_DIR=./uploads
